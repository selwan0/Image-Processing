  <property name="styleSheet">
   <string notr="true">QPushButton {
    background-color: #ffffff;
    color: #2e3440;
    border-radius: 5px;
    border: 1px solid #d8dee9;
    font-weight: bold;
    min-width: 130px;    
    max-width: 130px;
    min-height: 30px; 
    max-height: 30px;
}

QPushButton:hover {
    background-color: #eceff4;
    border-color: #5e81ac;
}

QPushButton:pressed {
    background-color: #e5e9f0;
}

QPushButton#loadbtn, QPushButton#savebtn {
    background-color: #ffffff;
    color: #2e3440;
    font-size: 13px;
    font-weight: bold;
    border-radius: 7px;
    border: 2px solid #5e81ac;
    min-width: 170px;  
    max-width: 170px;
    min-height: 36px;   
    max-height: 36px;
}

QPushButton#loadbtn:hover, QPushButton#savebtn:hover {
    background-color: #f0f4f8;
    border-color: #81a1c1;
}

QPushButton#loadbtn:pressed, QPushButton#savebtn:pressed {
    background-color: #e2e8f0;
}</string>
  </property>
